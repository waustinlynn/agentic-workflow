terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # Pass bucket and region via untracked backend.hcl (generated by scripts/bootstrap-state.sh):
  #   terraform init -backend-config=backend.hcl
  backend "s3" {
    key          = "iam-deploy/terraform.tfstate"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region              = var.aws_region
  allowed_account_ids = [var.aws_account_id]

  default_tags {
    tags = {
      Project   = "iam-deploy"
      ManagedBy = "terraform"
    }
  }
}
