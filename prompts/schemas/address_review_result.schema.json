{
  "$defs": {
    "VerifyCommandResult": {
      "additionalProperties": false,
      "description": "Outcome of executing a single verification command from ``.agentic/config.yaml``.",
      "properties": {
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "command",
        "passed"
      ],
      "title": "VerifyCommandResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured JSON output produced by the ``address_review`` prompt.",
  "properties": {
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "addressed_comments": {
      "items": {
        "type": "string"
      },
      "title": "Addressed Comments",
      "type": "array"
    },
    "verify_results": {
      "items": {
        "$ref": "#/$defs/VerifyCommandResult"
      },
      "title": "Verify Results",
      "type": "array"
    },
    "commit_message": {
      "minLength": 1,
      "title": "Commit Message",
      "type": "string"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    }
  },
  "required": [
    "summary",
    "commit_message"
  ],
  "title": "AddressReviewResult",
  "type": "object"
}
