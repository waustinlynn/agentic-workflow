terraform {
  required_version = ">= 1.10"

  # Pass bucket and region via untracked infra/backend.hcl (generated by scripts/bootstrap-state.sh):
  #   terraform init -backend-config=backend.hcl
  backend "s3" {
    key          = "agentic-workflow/terraform.tfstate"
    encrypt      = true
    use_lockfile = true
  }
}
