# Phase 2 worker-infra Lambda container image (layered on worker-base).
# Supports fast in-Lambda verify_commands with Terraform and jq.
ARG BASE_IMAGE=agentic-worker-base:latest
FROM ${BASE_IMAGE}

ENV TF_DATA_DIR=/tmp/.terraform \
    CHECKPOINT_DISABLE=1 \
    WORKER_RUNTIME=infra

CMD ["worker.lambda_handler.lambda_handler"]
