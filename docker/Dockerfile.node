# Phase 2 worker-node Lambda container image (layered on worker-base).
# Supports fast in-Lambda verify_commands with Node.js LTS, npm, and pnpm.
ARG BASE_IMAGE=agentic-worker-base:latest
FROM ${BASE_IMAGE}

ARG NODE_VERSION=22.23.5

RUN npm install -g pnpm \
    && rm -rf /tmp/.cache/npm /root/.npm

ENV NPM_CONFIG_CACHE=/tmp/.cache/npm \
    YARN_CACHE_FOLDER=/tmp/.cache/yarn \
    PNPM_STORE_DIR=/tmp/.cache/pnpm \
    COREPACK_HOME=/tmp/.cache/corepack \
    WORKER_RUNTIME=node

CMD ["worker.lambda_handler.lambda_handler"]
