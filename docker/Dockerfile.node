# Phase 2 worker-node Lambda container image (layered on worker-base).
# Supports fast in-Lambda verify_commands with Node.js LTS, npm, and pnpm.
ARG BASE_IMAGE=agentic-worker-base:latest
FROM ${BASE_IMAGE}

ARG NODE_VERSION=22.14.0

RUN arch="$(uname -m)" \
    && case "${arch}" in \
         x86_64) node_arch="x64" ;; \
         aarch64) node_arch="arm64" ;; \
         *) echo "Unsupported architecture: ${arch}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
         -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm -f /tmp/node.tar.xz \
    && npm install -g pnpm \
    && rm -rf /tmp/.cache/npm /root/.npm

ENV NPM_CONFIG_CACHE=/tmp/.cache/npm \
    YARN_CACHE_FOLDER=/tmp/.cache/yarn \
    PNPM_STORE_DIR=/tmp/.cache/pnpm \
    COREPACK_HOME=/tmp/.cache/corepack \
    WORKER_RUNTIME=node

CMD ["worker.lambda_handler.lambda_handler"]
