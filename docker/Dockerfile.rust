# Phase 2 worker-rust Lambda container image (layered on worker-base).
# Pattern for Rust repositories running cargo check/clippy/test inside Lambda.
ARG BASE_IMAGE=agentic-worker-base:latest
FROM ${BASE_IMAGE}

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

RUN dnf install -y gcc \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && curl -fsSL https://sh.rustup.rs \
         | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
    && rustup component add clippy rustfmt \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo

# Keep runtime cargo downloads & build artifacts under writable /tmp.
ENV CARGO_HOME=/tmp/.cargo \
    CARGO_TARGET_DIR=/tmp/cargo-target \
    WORKER_RUNTIME=rust

CMD ["worker.lambda_handler.lambda_handler"]
